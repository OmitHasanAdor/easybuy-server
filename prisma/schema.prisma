generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id              Int       @id @default(autoincrement())
  name            String    @unique
  price           Float
  description     String
  createdAt       DateTime  @default(now())
  category        String
  images          String[]  @default([])
  stock           Int       @default(10)
  isBestSeller    Boolean   @default(false)
  discountPercent Int?
  saleEndsAt      DateTime?
  hasVariants     Boolean   @default(false)
  updatedAt       DateTime  @updatedAt

  orderItems OrderItem[]
  variants   ProductVariant[]
  wishlists  Wishlist[]
  cartItems  CartItem[]
  reviews    Review[]
}

// One row per size/color combination for a product that has variants.
// Only relevant when Product.hasVariants is true.
model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int
  size      String?
  color     String?
  stock     Int      @default(0)
  price     Float? // optional override; falls back to Product.price when null
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  // prevents the same size+color combo being created twice for one product
  @@unique([productId, size, color])
}

// One row per user per saved product.
model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    String
  productId Int
  createdAt DateTime @default(now())

  user    user    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // a user can only wishlist the same product once
  @@unique([userId, productId])
}

// One row per user per (product + variant) in their cart.
model CartItem {
  id        Int      @id @default(autoincrement())
  userId    String
  productId Int
  variantId Int? // null when the product has no size/color variants
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    user            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // a user can only have one cart row per exact product+variant combo
  @@unique([userId, productId, variantId])
}

// One row per user per review left on a product.
model Review {
  id                Int      @id @default(autoincrement())
  userId            String
  productId         Int
  rating            Int // 1 to 5
  title             String?
  comment           String?
  verifiedPurchase  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    user    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // a user can only leave one review per product
  @@unique([userId, productId])
}

model account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  issuer                String?
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model jwks {
  id         String   @id
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())
  alg        String?
  crv        String?
}

model seller_request {
  id          String   @id
  userId      String
  storeName   String
  phone       String?
  description String?
  status      String   @default("PENDING")
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model user {
  id             String           @id
  name           String
  email          String           @unique
  emailVerified  Boolean          @default(false)
  image          String?
  role           String           @default("buyer")
  status         String           @default("active")
  phone          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  banExpires     DateTime?
  banReason      String?
  banned         Boolean          @default(false)
  account        account[]
  seller_request seller_request[]
  session        session[]
  orders         Order[]
  wishlists      Wishlist[]
  cartItems      CartItem[]
  reviews        Review[]
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}

model Order {
  id        Int      @id @default(autoincrement())
  userId    String
  total     Float
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  user        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]
}

model OrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}
