generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  description String
  category    String
  imageUrl    String
  stock       Int      @default(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}