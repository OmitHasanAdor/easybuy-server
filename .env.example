# Copy this file to .env.local and fill in the values.

PORT=5000
NODE_ENV=development

# Postgres (Neon). DATABASE_URL is used by the app, DIRECT_URL by prisma migrate.
DATABASE_URL="postgresql://user:password@host/easybuy?sslmode=require"
DIRECT_URL="postgresql://user:password@host/easybuy?sslmode=require"

# Frontend origin: used for the SSLCommerz success/fail/cancel redirects
# and allowed by CORS. https://easy-buy-ruddy.vercel.app is always allowed.
FRONTEND_URL="http://localhost:3000"

# Extra browser origins allowed by CORS, comma separated (e.g. Vercel previews).
CORS_ORIGINS=""

# Public URL of this server, used as the SSLCommerz IPN callback.
SERVER_PUBLIC_URL="http://localhost:5000"

# SSLCommerz payment gateway
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
# sandbox | live
SSLCOMMERZ_ENV="sandbox"
